/*
 * colors.rasi — палитра kanagawa-paper для rofi
 * ─────────────────────────────────────────────
 */

* {
    /* ── Surface ─────────────────────────────────────────────── */

    /* Фон окна лаунчера. Тот же тон, что Theme.background, но     */
    /* alpha 0.95 (плотнее, чем 0.85 у попапов бара): в лаунчере   */
    /* 8-10 строк текста, нужна гарантированная читаемость.        */
    bg-window:        rgba(42, 42, 55, 0.95);

    /* Тонкая рамка окна. Theme.edge — DCD7BA с alpha 0.30.        */
    edge:             rgba(220, 215, 186, 0.30);

    /* Фон поля поиска. Визуальный hint, что это input,            */
    /* той же логики, что hover-пилюля в попапах Quickshell.       */
    bg-input:         rgba(54, 54, 70, 0.60);

    /* Фон неактивной modi-кнопки (зона 3 справа сверху).          */
    /* Theme.inactiveAlt — приглушённая подложка.                  */
    bg-modi-idle:     #2A2A37;

    /* ── Text & icons ────────────────────────────────────────── */

    fg:               #DCD7BA;   /* основной текст и иконки — Theme.fg       */
    fg-subtle:        #aca9a4;   /* placeholder, неактивный — Theme.fgSubtle */
    fg-muted:         #9e9b93;   /* отключённое            — Theme.fgMuted   */

    /* ── Accent (приглушённая лаванда) ───────────────────────── */

    accent:           #b4a7b5;   /* Theme.accent — выбранная строка, активная modi */
    /* Тёмный тон для текста на лавандовом фоне. Theme.popupItemHoverFg. */
    fg-on-accent:     #1F1F28;

    /* ── Дефолты, чтобы виджеты в theme.rasi не наследовали      */
    /*    случайных значений до явного перебития.                  */
    background-color: transparent;
    text-color:       @fg;
}