import Quickshell
import "./modules/bar"

// ─────────────────────────────────────────────────────────────────────────────
// shell.qml — точка входа Quickshell.
//
// Variants по Quickshell.screens создаёт по одной копии Bar на каждый
// подключённый монитор. Реактивность означает, что при подключении нового
// монитора бар автоматически появится и на нём; при отключении — исчезнет.
//
// modelData в делегате — это ShellScreen текущего монитора, его нужно
// передать в Bar.screen, чтобы layer-shell поверхность создалась именно
// на этом дисплее (а не на дефолтном/первом).
// ─────────────────────────────────────────────────────────────────────────────
Variants {
    model: Quickshell.screens

    delegate: Bar {
		required property var modelData
        screen: modelData
    }
}
