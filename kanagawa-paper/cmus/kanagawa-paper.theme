# ─────────────────────────────────────────────────────────────────────
# cmus theme: kanagawa-paper (ink) — v3
# Стратегия: визуальное соответствие Quickshell-шеллу (Theme.qml).
#   default            → kitty fg #DCD7BA / bg #1F1F28 (opacity 0.85)
#   color0   (#393836) → separator между окнами
#   color1   (#c4746e) → statusError
#   color3   (#c4b28a) → курсор на играющем в НЕактивном окне (statusCaution)
#   color5   (#a292a3) → приглушённый акцент (заголовок альбома)
#   color6   (#8ea49e) → курсор на обычном треке в НЕактивном окне + info (statusOk)
#   color12  (#698a9b) → директории в browser view (5)
#   color13  (#b4a7b5) → ACCENT (заголовки, играющий, прогресс, statusline-fg)
#   color14  (#96ada7) → курсор в АКТИВНОМ окне (обычный И играющий — одинаково)
# Минимальная версия: cmus 2.12 (color_statusline_progress_*).
# ─────────────────────────────────────────────────────────────────────
# ─── Базовая поверхность окон ────────────────────────────────────────
# default наследует от kitty: реальный fg #DCD7BA и прозрачный bg.
set color_win_bg=default
set color_win_fg=default
set color_win_attr=default

# Командная строка (:set ..., поиск /...).
set color_cmdline_bg=default
set color_cmdline_fg=default
set color_cmdline_attr=default

# ─── Заголовки окон ──────────────────────────────────────────────────
# Топ-строка ("Library", "Metallica"): лаванда без отдельной плашки —
# заголовок «дышит» с прозрачным окном, как активные пилюли в баре.
set color_win_title_bg=default
set color_win_title_fg=13
set color_win_title_attr=bold

# Titleline (инфо о текущем играющем треке): тот же акцент-ритм.
set color_titleline_bg=default
set color_titleline_fg=13
set color_titleline_attr=bold

# Заголовок альбома внутри trackwin — приглушённая лаванда (color5),
# «второй уровень» акцента, чтобы не дублировать яркость win_title.
set color_trackwin_album_bg=default
set color_trackwin_album_fg=5
set color_trackwin_album_attr=default

# ─── Статусбар и прогресс ────────────────────────────────────────────
# Без отдельной «полки» (bg=default) — статусбар сливается с фоном окна,
# чтобы непрозрачный color0 не выбивался резкой полосой.
# fg=color13 (accent) — время, проценты и метки получают тот же лавандовый
# ритм, что и заголовки.
set color_statusline_bg=default
set color_statusline_fg=13
set color_statusline_attr=default

# Прогресс-бар: лавандовая заливка на прозрачном фоне.
# Аналог activeUnderline / прогресс-индикаторов в баре Quickshell.
set color_statusline_progress_bg=default
set color_statusline_progress_fg=13
set color_statusline_progress_attr=default

# ─── Играющий трек (без курсора на нём) ──────────────────────────────
# Только цвет текста — лаванда. Курсор может быть в другом месте,
# а сама строка играющего трека всегда подсвечена accent'ом.
set color_win_cur=13
set color_win_cur_attr=bold

# ─── Курсор-выделение в АКТИВНОМ окне ────────────────────────────────
# Стратегия: «где я сейчас» = ОДИН цвет (color14, пыльный циан),
# независимо от того, играет трек под курсором или нет. Холодный циан
# контрастирует с тёплым default-текстом и с тёплой лавандой играющего —
# глаз чётко различает три состояния: текст / курсор / играющий.
set color_win_cur_sel_bg=default
set color_win_cur_sel_fg=14
set color_win_cur_sel_attr=bold

# Курсор на НЕ-играющем треке: тот же color14, тот же bold.
set color_win_sel_bg=default
set color_win_sel_fg=14
set color_win_sel_attr=bold

# ─── Курсор-выделение в НЕАКТИВНОМ окне ──────────────────────────────
# Окно не в фокусе — курсор должен быть приглушённее активного, но
# различимо «обычный vs играющий». Цвета подобраны под пересмотр после
# финального применения; пока: color3 (statusCaution) на играющем,
# color6 (statusOk, та же холодная семья что и color14) на обычном.
set color_win_inactive_cur_sel_bg=default
set color_win_inactive_cur_sel_fg=3
set color_win_inactive_cur_sel_attr=default

set color_win_inactive_sel_bg=default
set color_win_inactive_sel_fg=3
set color_win_inactive_sel_attr=default

# ─── Директории в browser view (5) ───────────────────────────────────
# color12 (#698a9b) — читаемый синий, против color4 (#435965 — тёмный).
set color_win_dir=12

# ─── Системные сообщения в командной строке ──────────────────────────
# info  = color6 (statusOk),  error = color1 (statusError),
# separator = color0 (тонкая тёмная линия между окнами в view 1).
set color_info=6
set color_error=1
set color_separator=0
