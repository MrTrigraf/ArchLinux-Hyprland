{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
	    //"source": "~/.config/hypr/kanagawa/fastfetch/nyarch.png",
	    "type": "kitty",
	    "height": 15,
	    "padding": {
		    "top": 1
	    }
    },
    "display": {
        "separator": " ➜ "
    },
    "modules": [
        "break",
        "break",
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────────────┐",
        },

        {
            "type": "custom",
            "format": "  PC info"
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7} GHz",
            "key": " ├  "},
        {
            "type": "gpu",
            "format": "{1} {2} @ {12} GHz",
            "key": " ├ 󰢮 "},
        {
            "type": "disk",
            "key": " ├ 󰋊 "},
        {
            "type": "command",
            "key": " ├  ",
            "text": "awk 'NR > 1 { used += $4; total += $3 } END { if (total > 0) printf \"%.2f GiB / %.2f GiB (%.0f%%)\", used/1024/1024, total/1024/1024, (used/total)*100 }' /proc/swaps"},
        {
            "type": "memory",
            "key": " └ 󰑭 "},

        "break",

        {
            "type": "custom",
            "format": "  OS info"
        },
        {
            "type": "os",
            "key": " ├ 󰣇 "
        },
        {
            "type": "kernel",
            "key": " ├  "},
        {
            "type": "wm",
            "key": " ├  "},
        {
            "type": "packages",
            "key": " ├  "},
        {
            "type": "terminal",
            "key": " ├  "},
        {
            "type": "shell",
            "key": " ├  "},
        {
            "type": "command",
            "key": " ├ 󰈃 ",
            "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"},
        {
            "type": "uptime",
            "key": " └ 󰅐 "},
        {
            "type": "custom",
            "format": "└──── {#30}󰫍 {#31}󰫍 {#32}󰫍 {#33}󰫍 {#94}󰫍 {#35}󰫍 {#36}󰫍 {#37}󰫍{#} ─────────────────────────────────┘"
        }
    ]


}
